{
  "name": "Scenario 3 - Promotional Email Campaign",
  "flow": [
    {
      "id": 1,
      "module": "airtable:ActionSearchRecords",
      "version": 3,
      "parameters": {
        "__IMTCONN__": "YOUR_AIRTABLE_CONNECTION_ID"
      },
      "mapper": {
        "base": "YOUR_AIRTABLE_BASE_ID",
        "table": "YOUR_AIRTABLE_TABLE_ID",
        "fields": [
          "First Name",
          "Favorite Dish",
          "Email for Discount Code",
          "Marketing Consent"
        ],
        "maxRecords": "10",
        "useColumnId": false
      },
      "metadata": {
        "designer": {
          "x": -12,
          "y": 18
        },
        "restore": {
          "expect": {
            "base": {
              "mode": "chose",
              "label": "Your Airtable Base"
            },
            "sort": {
              "mode": "chose"
            },
            "view": {
              "mode": "chose"
            },
            "table": {
              "mode": "chose",
              "label": "Table 1"
            },
            "fields": {
              "mode": "chose",
              "label": [
                "First Name",
                "Favorite Dish",
                "Email for Discount Code",
                "Marketing Consent"
              ]
            },
            "useColumnId": {
              "mode": "chose"
            }
          },
          "parameters": {
            "__IMTCONN__": {
              "data": {
                "scoped": "true",
                "connection": "airtable3"
              },
              "label": "Your Airtable Connection"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:airtable3,airtable2",
            "label": "Connection",
            "required": true
          }
        ],
        "interface": [
          {
            "name": "__IMTLENGTH__",
            "label": "Total number of bundles",
            "type": "uinteger"
          },
          {
            "name": "__IMTINDEX__",
            "label": "Bundle order position",
            "type": "uinteger"
          },
          {
            "name": "id",
            "type": "text",
            "label": "ID"
          },
          {
            "name": "createdTime",
            "type": "date",
            "label": "Created Time"
          },
          {
            "name": "First Name",
            "type": "text",
            "label": "First Name"
          },
          {
            "name": "Favorite Dish",
            "type": "text",
            "label": "Favorite Dish"
          },
          {
            "name": "Email for Discount Code",
            "type": "text",
            "label": "Email for Discount Code"
          },
          {
            "name": "Marketing Consent",
            "type": "boolean",
            "label": "Marketing Consent"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "zoho-mail:sendMail",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "YOUR_ZOHOMAIL_CONNECTION_ID"
      },
      "filter": {
        "name": "Marketing consent filter",
        "conditions": [
          [
            {
              "a": "{{1.`Marketing Consent`}}",
              "b": "{{true}}",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {
        "subject": "We haven't forgotten about you! 😊",
        "content": "Hey {{1.`First Name`}}!\n\nWe have a delicious surprise just for you 🍕\nRight now, your favorite dish – {{1.`Favorite Dish`}}\nis available with a 10% discount!\n\nCome visit us – the offer is waiting! 😋\nShow this email on your next visit to get 10% off! 🍕🔥\nValid for 24 hours from: {{formatDate(now; \"D.MM.YYYY HH:mm\")}}\n\n[RESTAURANT_NAME]\n",
        "encoding": "UTF-8",
        "accountId": "YOUR_ZOHO_ACCOUNT_ID",
        "ccAddress": [],
        "bccAddress": [],
        "mailFormat": "plaintext",
        "toAddress": [
          "{{1.`Email for Discount Code`}}"
        ],
        "fromAddress": "your-email@yourdomain.com"
      },
      "metadata": {
        "designer": {
          "x": 450,
          "y": 6
        },
        "restore": {
          "expect": {
            "encoding": {
              "label": "UTF-8"
            },
            "accountId": {
              "mode": "chose",
              "label": "your-email@yourdomain.com"
            },
            "toAddress": {
              "items": [
                null
              ]
            },
            "mailFormat": {
              "label": "Plain Text"
            }
          },
          "parameters": {
            "__IMTCONN__": {
              "data": {
                "scoped": "true",
                "connection": "zoho-mail"
              },
              "label": "Your Zoho Mail Connection"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:zoho-mail",
            "label": "Connection",
            "required": true
          }
        ]
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu2.make.com",
    "notes": []
  }
}